---
import WorkProjectDetail from '@/lib/domain/work/project/WorkProjectDetail.astro';
import { workProjectsById } from '@/lib/domain/work/project/workProjectsById.data';
import { WorkProjectId } from '@/lib/domain/work/project/WorkProject';
import { LandingPage } from '@/lib/ui';
import { makeHomeSherpa } from '@/lib/domain/homePage/homePage.sherpa';

const sherpa = makeHomeSherpa();

export function getStaticPaths() {
  return Object.values(WorkProjectId).map(id => ({
    params: { slug: id },
  }));
}

const { slug } = Astro.params;
const project = workProjectsById[slug as WorkProjectId];

if (!project) {
  return Astro.redirect('/404');
}
---

<LandingPage.Container>
  <LandingPage.Header
    navMenuItems={[
      { href: sherpa.work.index({}), text: 'Work' },
      { href: sherpa.family.index({}), text: 'Family' },
      { href: sherpa.play.index({}), text: 'Play' },
    ]}
    breadcrumbs={[
      { label: 'Work', href: sherpa.work.index({}) },
      { label: 'Projects', href: sherpa.work.projects.index({}) },
      { label: project.name },
    ]}
    slot="header"
  />

  <LandingPage.Body slot="content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <WorkProjectDetail project={project} />
  </LandingPage.Body>
</LandingPage.Container>
