---
import { LandingPage } from '@/lib/ui/layouts/LandingPage';
import { getCollection } from 'astro:content';

const skills = await getCollection('work/skills');

// Sort skills by recruiter value (highest first)
const sortedSkills = skills.sort((a, b) => b.data.recruiterValue - a.data.recruiterValue);

// Group skills by parentSkillId or list them if they have no parent
const topLevelSkills = sortedSkills.filter(skill => !skill.data.parentSkillId);
const skillsWithChildren = topLevelSkills.map(skill => {
  const children = sortedSkills.filter(s => s.data.parentSkillId === skill.data.id);
  return {
    skill,
    children,
  };
});

// Helper to create slug
const createSlug = (id: string) => id.toLowerCase().replace(/[^\w-]+/g, '-');
---

<LandingPage.Container title="Work Skills | Andrew Holbrook">
  <LandingPage.Header slot="header" />
  <LandingPage.Body slot="content" backgroundColor="bg-gray-100">
    <div class="container mx-auto px-4 py-8">
      <div class="mb-12 text-center">
        <h1 class="text-4xl font-bold mb-4">Skills & Expertise</h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          I've developed a diverse skill set throughout my career. Here's a comprehensive overview
          of my technical expertise and professional capabilities.
        </p>
        <div class="mt-6">
          <a
            href="/work/skills/progression"
            class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-md transition-colors"
          >
            View Career Progression
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          skillsWithChildren.map(({ skill, children }) => (
            <div class="border rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow bg-white">
              <div class="p-6">
                <div class="flex justify-between items-center mb-4">
                  <h2 class="text-2xl font-bold">
                    <a
                      href={`/work/skills/${createSlug(skill.data.id)}`}
                      class="text-blue-600 hover:text-blue-800"
                    >
                      {skill.data.name}
                    </a>
                  </h2>
                  <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm">
                    {skill.data.recruiterValue}/10
                  </span>
                </div>

                {skill.data.description && (
                  <p class="text-gray-600 mb-6">{skill.data.description}</p>
                )}

                {children.length > 0 && (
                  <div>
                    <h3 class="text-lg font-semibold mb-2">Related Skills:</h3>
                    <div class="flex flex-wrap gap-2">
                      {children.map(childSkill => (
                        <a
                          href={`/work/skills/${createSlug(childSkill.data.id)}`}
                          class="inline-block bg-gray-100 hover:bg-gray-200 px-3 py-1 rounded-full text-sm transition-colors"
                        >
                          {childSkill.data.name}
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </LandingPage.Body>
  <LandingPage.Footer slot="footer" />
</LandingPage.Container>
