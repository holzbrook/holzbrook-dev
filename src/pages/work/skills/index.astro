---
import { LandingPage } from '@/lib/ui/layouts/LandingPage';
import { getCollection } from 'astro:content';

const skills = await getCollection('work/skills');

// Sort skills by recruiter value (highest first)
const sortedSkills = skills.sort((a, b) => b.data.recruiterValue - a.data.recruiterValue);

// Group skills by parentSkillId or list them if they have no parent
const topLevelSkills = sortedSkills.filter(skill => !skill.data.parentSkillId);
const skillsWithChildren = topLevelSkills.map(skill => {
  const children = sortedSkills.filter(s => s.data.parentSkillId === skill.data.id);
  return {
    skill,
    children,
  };
});

// Helper to create slug
const createSlug = (id: string) => id.toLowerCase().replace(/[^\w-]+/g, '-');
---

<LandingPage.Container title="Work Skills | Andrew Holbrook">
  <LandingPage.Header slot="header" />
  <LandingPage.Body slot="content" backgroundColor="bg-gray-100">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <div class="mb-12 text-center bg-white rounded-lg shadow-sm p-8 md:p-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Skills & Expertise</h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          I've developed a diverse skill set throughout my career. Here's a comprehensive overview
          of my technical expertise and professional capabilities.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          skillsWithChildren.map(({ skill, children }) => (
            <div class="border border-gray-200 rounded-2xl bg-white shadow-sm hover:shadow-md transition-shadow">
              <a
                class="flex flex-col gap-4 p-6 h-full"
                href={`/work/skills/${createSlug(skill.data.id)}`}
              >
                <div>
                  <p class="text-xs uppercase tracking-wide text-gray-500">Skill</p>
                  <h2 class="text-2xl font-semibold text-gray-900">{skill.data.name}</h2>
                </div>
                {skill.data.description && (
                  <p class="text-gray-600 text-sm leading-relaxed">{skill.data.description}</p>
                )}
                {children.length > 0 && (
                  <div class="pt-3 border-t border-gray-100">
                    <p class="text-xs font-semibold text-gray-500 mb-2">Highlights</p>
                    <div class="flex flex-wrap gap-2 text-xs text-gray-700">
                      {children.slice(0, 4).map(child => (
                        <span class="px-2 py-1 bg-gray-100 rounded-full">{child.data.name}</span>
                      ))}
                      {children.length > 4 && (
                        <span class="px-2 py-1 bg-gray-50 rounded-full text-gray-500">
                          +{children.length - 4} more
                        </span>
                      )}
                    </div>
                  </div>
                )}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </LandingPage.Body>
  <LandingPage.Footer slot="footer" />
</LandingPage.Container>
