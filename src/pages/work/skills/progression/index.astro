---
import { LandingPage } from '@/lib/ui/layouts/LandingPage';
import { getCollection } from 'astro:content';

// Get all skills
const skills = await getCollection('work/skills');

// Define an interface for career progression items
interface CareerPeriod {
  company: string;
  period: string;
  title: string;
  skills: string[];
  projects?: string[];
  responsibilities?: string[];
}

// Career progression data
const careerProgression: CareerPeriod[] = [
  {
    company: 'Chatbooks',
    period: '2020 - Present',
    title: 'Senior Frontend Engineer',
    skills: [
      'React', 'Next.js', 'TypeScript', 'Redux', 'React Query', 
      'Chakra UI', 'Tailwind CSS', 'Flutter', 'Dart', 'CI/CD',
      'Responsive Design'
    ],
    projects: [
      'WordPress to Headless CMS React Migration',
      'Web Cart',
      'Legacy Site Maintenance',
      'Greenfield NextJS Marketing Site',
      'Full Stack Designer Covers for Web',
      'Convert Mobile-first Flutter Solution to Fully Responsive',
      'Full Stack Designer Covers for Flutter',
    ]
  },
  {
    company: 'Sling TV',
    period: '2018 - 2020',
    title: 'Frontend Engineer',
    skills: [
      'React', 'JavaScript', 'Webpack', 'Node.js', 'HTML5/CSS3'
    ],
    projects: [
      'Core streaming application interface',
      'Performance optimizations',
      'Cross-platform web components'
    ]
  },
  {
    company: 'MasterControl',
    period: '2012 - 2018',
    title: 'Software Engineer',
    skills: [
      'Angular 2', 'React', 'Java', 'Spring MVC', 'Spring Boot',
      'SQL', 'ColdFusion', 'Agile/Scrum', 'TDD', 'Architecture'
    ],
    projects: [
      'QuickNav', 
      'Elasticsearch integration', 
      'Batch Processing UI',
      'Core QMS modules'
    ]
  },
  {
    company: 'Trivir',
    period: '2011 - 2012',
    title: 'Junior Developer',
    skills: [
      'HTML5/CSS3', 'JavaScript', 'VMWare'
    ],
    responsibilities: [
      'Archived and organized client projects',
      'Wrote integration tests for Identity Management Systems'
    ]
  },
  {
    company: 'Utah Valley University',
    period: '2006 - 2011',
    title: 'Computer Science Student',
    skills: [
      'C#', 'SQL', 'C++', 'C', 'HTML5/CSS3', 'JavaScript', 'OpenGL'
    ],
    projects: [
      'Compiler',
      'Virtual Machine',
      '3D Graphics Projects',
      'Neural Network',
      'C#/.NET Projects',
    ]
  }
];

// Helper function to find skill by name
const findSkill = (name: string) => {
  return skills.find(skill => 
    skill.data.name.toLowerCase() === name.toLowerCase() || 
    skill.data.id.toLowerCase() === name.toLowerCase()
  );
};
---

<LandingPage.Container title="Skills Progression | Andrew Holbrook">
  <LandingPage.Header slot="header" />
  <LandingPage.Body slot="content" backgroundColor="bg-gray-100">
    <div class="container mx-auto px-4 py-8">
      <div class="mb-12 text-center">
        <h1 class="text-4xl font-bold mb-4">Career Skills Progression</h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          My journey from a computer science student to a senior frontend engineer, highlighting the skills I've developed along the way.
        </p>
        <div class="mt-6">
          <a 
            href="/work/skills" 
            class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-md transition-colors"
          >
            View All Skills
          </a>
        </div>
      </div>

      <div class="relative">
        <!-- Vertical Timeline Line -->
        <div class="absolute left-1/2 transform -translate-x-1/2 h-full w-1 bg-blue-200"></div>
        
        <div class="relative z-10">
          {careerProgression.map((period, index) => (
            <div class={`mb-16 flex flex-col ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} items-center`}>
              <div class="md:w-1/2 mb-6 md:mb-0 flex items-center justify-center md:justify-end">
                <div class={`bg-white rounded-lg shadow-md p-6 max-w-md ${index % 2 === 0 ? 'md:mr-8' : 'md:ml-8'}`}>
                  <h2 class="text-2xl font-bold text-blue-800 mb-1">{period.company}</h2>
                  <h3 class="text-xl font-medium text-gray-700 mb-3">{period.title}</h3>
                  <p class="text-gray-500 mb-4">{period.period}</p>
                  
                  {period.projects && (
                    <div class="mb-4">
                      <h4 class="text-lg font-semibold mb-2">Key Projects:</h4>
                      <ul class="list-disc list-inside text-gray-700">
                        {period.projects.map((project: string) => (
                          <li>{project}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                  
                  {period.responsibilities && (
                    <div class="mb-4">
                      <h4 class="text-lg font-semibold mb-2">Responsibilities:</h4>
                      <ul class="list-disc list-inside text-gray-700">
                        {period.responsibilities.map((resp: string) => (
                          <li>{resp}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </div>
              
              <div class="md:w-1/2 flex flex-col items-center">
                <!-- Timeline dot -->
                <div class="w-6 h-6 rounded-full bg-blue-500 border-4 border-white shadow-md mb-6"></div>
                
                <!-- Skills -->
                <div class={`bg-white rounded-lg shadow-md p-6 max-w-md ${index % 2 === 0 ? 'md:ml-8' : 'md:mr-8'}`}>
                  <h4 class="text-lg font-semibold mb-3">Skills Developed:</h4>
                  <div class="flex flex-wrap gap-2">
                    {period.skills.map((skillName: string) => {
                      const skillEntry = findSkill(skillName);
                      const skillUrl = skillEntry ? 
                        `/work/skills/${skillEntry.data.id.toLowerCase().replace(/[^\w-]+/g, '-')}` : null;
                      
                      return (
                        <div>
                          {skillUrl ? (
                            <a 
                              href={skillUrl} 
                              class="inline-block bg-blue-100 hover:bg-blue-200 text-blue-800 px-3 py-1 rounded-full text-sm transition-colors"
                            >
                              {skillName}
                            </a>
                          ) : (
                            <span class="inline-block bg-gray-100 text-gray-800 px-3 py-1 rounded-full text-sm">
                              {skillName}
                            </span>
                          )}
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </LandingPage.Body>
  <LandingPage.Footer slot="footer" />
</LandingPage.Container> 