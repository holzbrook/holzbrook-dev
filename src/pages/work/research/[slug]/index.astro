---
import WorkResearchDetail from '@/lib/domain/work/research/WorkResearchDetail.astro';
import { researchById } from '@/content/work/research/researchById.data';
import { WorkResearchId } from '@/lib/domain/work/research/WorkResearch';
import { LandingPage } from '@/lib/ui';
import { makeHomeSherpa } from '@/lib/domain/homePage/homePage.sherpa';

const sherpa = makeHomeSherpa();

export function getStaticPaths() {
  return Object.values(WorkResearchId).map(id => ({
    params: { slug: id },
  }));
}

const { slug } = Astro.params;
const research = researchById[slug as WorkResearchId];

if (!research) {
  return Astro.redirect('/404');
}
---

<LandingPage.Container>
  <LandingPage.Header
    navMenuItems={[
      { href: sherpa.work.index({}), text: 'Work' },
      { href: sherpa.family.index({}), text: 'Family' },
      { href: sherpa.play.index({}), text: 'Play' },
    ]}
    breadcrumbs={[
      { label: 'Work', href: sherpa.work.index({}) },
      { label: 'Research', href: '/work/research' },
      { label: research.title },
    ]}
    slot="header"
  />

  <LandingPage.Body slot="content" class="px-4 sm:px-6 lg:px-8 pt-16 pb-8">
    <WorkResearchDetail research={research} />
  </LandingPage.Body>
</LandingPage.Container>
