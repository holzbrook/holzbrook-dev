---
import { getWorkPageData } from '@/content/work/workPage.data';

const pageData = await getWorkPageData(); // Await the data
---

<header class="mb-5">
  <div class="flex justify-between w-full mb-2">
    <div>
      <h1 class="text-2xl sm:text-3xl font-semibold mb-1.5 text-gray-900">
        {pageData.candidate.name}
      </h1>
      <h2 class="text-gray-700 text-lg">
        {pageData.candidate.title}
      </h2>
    </div>
    <div class="text-right">
      <address class="text-xs not-italic mb-2">
        <div class="mb-1">
          <a href={`mailto:${pageData.candidate.email}`} class="text-gray-600 hover:underline">
            {pageData.candidate.email}
          </a>
        </div>
        <div class="mb-1">
          <a
            href={`tel:+1${pageData.candidate.phone.replace(/-/g, '')}`}
            class="text-gray-600 hover:underline"
          >
            {pageData.candidate.phone}
          </a>
        </div>
      </address>
      <div class="text-xs space-y-1">
        {
          pageData.candidate.website && (
            <div>
              <a
                href={pageData.candidate.website}
                class="text-gray-600 hover:underline"
                target="_blank"
                rel="noopener noreferrer"
              >
                {pageData.candidate.website}
              </a>
            </div>
          )
        }
        {
          pageData.candidate.linkedIn && (
            <div>
              <a
                href={pageData.candidate.linkedIn}
                class="text-gray-600 hover:underline"
                target="_blank"
                rel="noopener noreferrer"
              >
                {pageData.candidate.linkedIn}
              </a>
            </div>
          )
        }
        {
          pageData.candidate.github && (
            <div>
              <a
                href={pageData.candidate.github}
                class="text-gray-600 hover:underline"
                target="_blank"
                rel="noopener noreferrer"
              >
                {pageData.candidate.github}
              </a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</header>

<!-- Professional Summary -->
<section class="mb-5 p-3 rounded-md">
  <p class="leading-relaxed text-gray-800">{pageData.candidate.summary}</p>
</section>

<!-- Work Experience Section -->
<section class="mb-7">
  <h2 class="text-lg sm:text-xl font-bold text-gray-900 mb-3 border-b-2 border-gray-400 pb-1">
    Work Experience
  </h2>
  <div class="space-y-5">
    {
      pageData.candidate.jobs.map(job => (
        <article>
          <header class="font-semibold text-base text-gray-900 flex items-baseline">
            <span class="mr-2">{job.company}</span>
            <span class="font-normal italic text-gray-800 mr-auto">- {job.title}</span>
            <span class="text-gray-700 text-sm">{job.period}</span>
          </header>
          <ul class="list-disc ml-6 mt-1.5 space-y-0.5 text-sm text-gray-700">
            {job.highlights.map((highlight: string) => (
              <li>
                <span class={highlight.includes(':') ? 'text-gray-900' : 'text-gray-600'}>
                  {highlight}
                </span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>

<!-- Education -->
<footer class="text-center
  mt-5
  border-t
  border-gray-300
  pt-3">
  <p class="text-xs
    text-gray-600">
    B.S. in Computer Science, Utah Valley University, April 2013
  </p>
</footer>
