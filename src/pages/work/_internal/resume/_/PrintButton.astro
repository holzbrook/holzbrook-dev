---
import { PrintIcon } from '@/lib/ui/icons';
interface Props {
  class?: string;
}

const { class: className = '' }: Props = Astro.props;
---

<button
  class={`px-6 py-3 bg-gray-700 text-white rounded-lg shadow-lg hover:bg-gray-800 hover:shadow-2xl hover:scale-105 hover:pointer focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition-transform transition-colors duration-300 ease-in-out transform flex items-center gap-2 ${className}`}
  id="print-button"
>
  <PrintIcon />
  <slot />
</button>

<script>
  const printButton = document.getElementById('print-button');
  printButton?.addEventListener('click', () => window.print());
</script>
