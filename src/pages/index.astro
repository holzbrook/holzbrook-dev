---
import { Icon } from 'astro-icon/components';
import { ExploreCard, LandingPage } from '@/lib/ui';
import HomePageHero from '@/lib/ui/heroes/HomePageHero.astro';
import { HomePageBusinessCard } from '@/lib/domain/homePage/ui';
import { makeHomeSherpa } from '@/lib/domain/homePage/homePage.sherpa';
import { getHomePageData } from '@/content/home/homePage.data';
import { getWorkPageData } from '@/content/work/workPage.data';

const sherpa = makeHomeSherpa();
const homePageData = await getHomePageData();
const workData = await getWorkPageData();
---

<LandingPage.Container>
  <LandingPage.Body slot="content" backgroundColor="bg-gray-100" class="flex flex-col min-h-screen">
    <HomePageHero data-testid="home-hero" title={homePageData.title} />

    <div class="flex justify-center -mt-16">
      <HomePageBusinessCard.Container>
        <div class="flex items-center justify-between mb-4">
          <HomePageBusinessCard.JobTitle>
            {workData.candidate.title}
          </HomePageBusinessCard.JobTitle>
          <HomePageBusinessCard.Avatar />
        </div>

        <div class="space-y-3">
          <HomePageBusinessCard.Link href={`mailto:${workData.candidate.email}`}>
            <Icon name="email" class="w-6 h-6" />
            {workData.candidate.email}
          </HomePageBusinessCard.Link>

          <HomePageBusinessCard.Link
            href={sherpa.work.resumePdf()}
            download="Andrew Holbrook Resume.pdf"
          >
            <Icon name="file-document" class="w-6 h-6" />
            Download Resume (PDF)
          </HomePageBusinessCard.Link>

          {
            workData.candidate.linkedIn && (
              <HomePageBusinessCard.Link href={workData.candidate.linkedIn}>
                <Icon name="linkedin" class="w-6 h-6" />
                LinkedIn
              </HomePageBusinessCard.Link>
            )
          }

          {
            workData.candidate.github && (
              <HomePageBusinessCard.Link href={workData.candidate.github}>
                <Icon name="github" class="w-6 h-6" />
                GitHub
              </HomePageBusinessCard.Link>
            )
          }
        </div>
      </HomePageBusinessCard.Container>
    </div>

    {
      homePageData.subtitle && (
        <div class="text-center mt-24 mb-8">
          <p class="text-lg lg:text-xl text-gray-700 max-w-2xl mx-auto px-4 leading-relaxed">
            Currently exploring{' '}
            <a
              href="/work/research/semantic-path-fractals"
              class="text-gray-900 hover:text-gray-600 underline transition-colors"
            >
              a computational framework
            </a>{' '}
            that might reshape how we think about application development.{' '}
            <a
              href="/work/research/semantic-path-fractals"
              class="text-gray-600 hover:text-gray-900 underline transition-colors"
            >
              Learn more
            </a>
            .
          </p>
        </div>
      )
    }

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
      <hr class="border-stone-300" />
    </div>

    <section class="py-12">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <ExploreCard.Container
            bgColor={homePageData.sections.work.bgColor}
            class="flex flex-col items-center text-center"
          >
            <ExploreCard.Title>
              {homePageData.sections.work.title}
            </ExploreCard.Title>
            <ExploreCard.Blurb>
              {homePageData.sections.work.description}
            </ExploreCard.Blurb>
            <ExploreCard.Cta
              href={homePageData.sections.work.link}
              class={homePageData.sections.work.ctaClass}
            >
              {homePageData.sections.work.cta}
            </ExploreCard.Cta>
          </ExploreCard.Container>

          <ExploreCard.Container
            bgColor={homePageData.sections.family.bgColor}
            class="flex flex-col items-center text-center"
          >
            <ExploreCard.Title>
              {homePageData.sections.family.title}
            </ExploreCard.Title>
            <ExploreCard.Blurb>
              {homePageData.sections.family.description}
            </ExploreCard.Blurb>
            <ExploreCard.Cta
              href={homePageData.sections.family.link}
              class={homePageData.sections.family.ctaClass}
            >
              {homePageData.sections.family.cta}
            </ExploreCard.Cta>
          </ExploreCard.Container>

          <ExploreCard.Container
            bgColor={homePageData.sections.play.bgColor}
            class="flex flex-col items-center text-center"
          >
            <ExploreCard.Title>
              {homePageData.sections.play.title}
            </ExploreCard.Title>
            <ExploreCard.Blurb>
              {homePageData.sections.play.description}
            </ExploreCard.Blurb>
            <ExploreCard.Cta
              href={homePageData.sections.play.link}
              class={homePageData.sections.play.ctaClass}
            >
              {homePageData.sections.play.cta}
            </ExploreCard.Cta>
          </ExploreCard.Container>
        </div>
      </div>
    </section>

    <LandingPage.Footer />
  </LandingPage.Body>
</LandingPage.Container>
