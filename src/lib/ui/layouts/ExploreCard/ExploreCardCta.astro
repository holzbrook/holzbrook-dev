---
import { App } from '../../../app';

interface Props {
  href: string;
  class?: string;
  'data-testid'?: string;
}

const { href, class: className, 'data-testid': dataTestId }: Props = Astro.props;
---

<App.Link
  href={href}
  class={`px-4 py-2 text-sm text-white rounded-lg shadow-md transition-colors duration-300 ${className ?? ''}`}
  data-testid={dataTestId}
>
  <slot />
</App.Link>
