---
interface Props {
  class?: string;
  title: string;
  subtitle?: string;
  'data-testid'?: string;
}

const { class: className, title, subtitle, 'data-testid': dataTestId } = Astro.props;
---

<section
  role="banner"
  data-testid={dataTestId}
  class={`
    relative
    py-24
    text-center
    overflow-hidden
    ${className}
  `}
>
  <div
    class={`
      absolute
      inset-0
      bg-[#B45309]
    `}
    role="presentation"
  >
  </div>
  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1
      role="heading"
      aria-level="1"
      class="text-5xl lg:text-6xl font-extrabold text-stone-50 drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)] leading-tight mb-6 -mt-2 pb-4 border-b-2 border-stone-200/50"
    >
      {title}
    </h1>
  </div>
</section>
