---
interface Props {
  variant?: 'primary' | 'secondary' | 'outlined' | 'filter';
  size?: 'sm' | 'md' | 'lg';
  as?: 'button' | 'a';
  href?: string;
  target?: string;
  rel?: string;
  class?: string;
  'data-testid'?: string;
  'data-category'?: string;
}

const {
  variant = 'primary',
  size = 'md',
  as: Tag = 'button',
  href,
  target,
  rel,
  class: className = '',
  'data-testid': dataTestId,
  'data-category': dataCategory,
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-medium transition-colors flex-shrink-0';

const sizeStyles = {
  sm: 'px-3 py-1 text-xs rounded-md',
  md: 'px-4 py-2 text-sm rounded-md',
  lg: 'px-5 py-2.5 text-base rounded-md',
};

const variantStyles = {
  primary: 'bg-gray-700 text-white hover:bg-gray-800 rounded-md',
  secondary: 'bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-md',
  outlined: 'bg-white border border-gray-300 text-gray-700 hover:border-gray-400 hover:bg-gray-50 rounded-md',
  filter: 'rounded-full',
};

const filterVariantStyles = {
  active: 'bg-stone-200 text-stone-800 hover:bg-stone-300',
  inactive: 'bg-gray-100 text-gray-800 hover:bg-gray-200',
};

const getVariantClass = () => {
  if (variant === 'filter') {
    return dataCategory === 'All' || className.includes('active-filter')
      ? filterVariantStyles.active
      : filterVariantStyles.inactive;
  }
  return variantStyles[variant];
};

const allClasses = `${baseStyles} ${sizeStyles[size]} ${getVariantClass()} ${className}`;

---
{Tag === 'a' ? (
  <a
    href={href}
    target={target}
    rel={rel}
    class={allClasses}
    data-testid={dataTestId}
    data-category={dataCategory}
  >
    <slot />
  </a>
) : (
  <button
    class={allClasses}
    data-testid={dataTestId}
    data-category={dataCategory}
  >
    <slot />
  </button>
)}
