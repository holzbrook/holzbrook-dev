---
import Button from './Button.astro';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  as?: 'button' | 'a';
  href?: string;
  target?: string;
  rel?: string;
  class?: string;
  'data-testid'?: string;
}

const { size, as, href, target, rel, class: className, 'data-testid': dataTestId } = Astro.props;
---

<Button
  variant="primary"
  size={size}
  as={as}
  href={href}
  target={target}
  rel={rel}
  class={className}
  data-testid={dataTestId}
>
  <slot />
</Button>
