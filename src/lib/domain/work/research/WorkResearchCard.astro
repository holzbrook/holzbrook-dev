---
import { H3, P, SecondaryButton } from '@/lib/ui';
import type { WorkResearch } from './WorkResearch';

interface Props {
  research: WorkResearch;
  class?: string;
}

const { research, class: className } = Astro.props;
const { title, description, status, disclosureDate, technicalDomains } = research;
---

<div
  class:list={[
    'bg-white rounded-lg shadow-md p-8 space-y-4 transition-all duration-300 hover:shadow-lg',
    className,
  ]}
>
  <div class="space-y-3">
    <H3 class="text-xl font-semibold text-gray-900">{title}</H3>
    <div class="flex items-center gap-3 flex-wrap">
      <span
        class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium"
        class:list={[
          status === 'research' && 'bg-stone-100 text-stone-700',
          status === 'development' && 'bg-stone-100 text-stone-700',
          status === 'patent-pending' && 'bg-stone-200 text-stone-800',
          status === 'published' && 'bg-stone-100 text-stone-700',
        ]}
      >
        {status.replace('-', ' ')}
      </span>
      <span class="text-sm text-gray-500">Disclosed: {disclosureDate}</span>
    </div>
  </div>

  <P class="text-lg text-gray-600 leading-relaxed">{description}</P>

  <div class="flex items-start sm:items-center justify-between gap-4 pt-2 flex-wrap">
    <div class="flex flex-wrap gap-2">
      {
        technicalDomains.map(domain => (
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800 hover:bg-gray-200 transition-colors">
            {domain}
          </span>
        ))
      }
    </div>
    <SecondaryButton as="a" href={`/work/research/${research.id}`}>
      View Details
      <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
        ></path>
      </svg>
    </SecondaryButton>
  </div>
</div>
