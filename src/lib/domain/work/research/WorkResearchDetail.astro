---
import { H1, H2, H3, P, Ul, Li } from '@/lib/ui';
import type { WorkResearch } from './WorkResearch';

interface Props {
  research: WorkResearch;
}

const { research } = Astro.props;
const {
  title,
  subtitle,
  description,
  intro,
  githubUrl,
  status,
  disclosureDate,
  concepts,
  technicalDomains,
  keyInnovations,
  potentialApplications,
  notes,
  developmentHistory,
} = research;
---

<article class="max-w-4xl mx-auto space-y-8">
  <!-- Header Card -->
  <div class="bg-white rounded-lg shadow-md p-8">
    <header>
      <H1 class="text-4xl font-bold text-gray-900 mb-2">{title}</H1>
      {subtitle && <P class="text-lg font-medium text-gray-600 italic mb-4">{subtitle}</P>}
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <span
          class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium"
          class:list={[
            status === 'research' && 'bg-stone-100 text-stone-700',
            status === 'development' && 'bg-stone-100 text-stone-700',
            status === 'patent-pending' && 'bg-stone-200 text-stone-800',
            status === 'published' && 'bg-stone-100 text-stone-700',
          ]}
        >
          {status.replace('-', ' ')}
        </span>
        <span class="text-lg text-gray-600">Disclosed: {disclosureDate}</span>
        {
          githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-lg text-gray-600 hover:text-gray-800 transition-colors"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                  clip-rule="evenodd"
                />
              </svg>
              <span>View on GitHub</span>
            </a>
          )
        }
      </div>
      <P class="text-xl text-gray-600">{description}</P>
      {
        intro && (
          <aside class="mt-6 ml-2 pl-6 pr-4 py-4 border-l-4 border-gray-300 bg-gray-50 rounded-r-lg italic text-gray-600 text-base leading-relaxed">
            {Array.isArray(intro) ? (
              <div class="space-y-3">
                {intro.map(paragraph => (
                  <P class="m-0">{paragraph}</P>
                ))}
              </div>
            ) : (
              <P class="m-0">{intro}</P>
            )}
          </aside>
        )
      }
    </header>
  </div>

  <!-- Development History -->
  {
    developmentHistory && (
      <div class="bg-stone-50 border-l-4 border-stone-400 rounded-lg shadow-sm p-6">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-stone-400 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
              <path
                fill-rule="evenodd"
                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
                clip-rule="evenodd"
              />
            </svg>
          </div>
          <div class="ml-3">
            <P class="text-sm text-stone-700 leading-relaxed">{developmentHistory}</P>
          </div>
        </div>
      </div>
    )
  }

  <!-- Key Innovations Card -->
  {
    keyInnovations.length > 0 && (
      <section class="bg-white rounded-lg shadow-md p-8">
        <H2 class="text-2xl font-semibold text-gray-900 mb-4">Key Innovations</H2>
        <Ul class="space-y-3">
          {keyInnovations.map(innovation => (
            <Li class="flex items-start text-gray-700">
              <svg
                class="w-5 h-5 text-gray-600 mr-3 mt-0.5 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"
                />
              </svg>
              <P class="text-gray-700 leading-relaxed">{innovation}</P>
            </Li>
          ))}
        </Ul>
        {technicalDomains.length > 0 && (
          <div class="mt-8 pt-8 border-t border-gray-200">
            <H3 class="text-lg font-semibold text-gray-900 mb-3">Technical Domains</H3>
            <div class="flex flex-wrap gap-2">
              {technicalDomains.map(domain => (
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
                  {domain}
                </span>
              ))}
            </div>
          </div>
        )}
      </section>
    )
  }

  <!-- Core Concepts Card -->
  {
    concepts.length > 0 && (
      <section class="bg-white rounded-lg shadow-md p-8">
        <H2 class="text-2xl font-semibold text-gray-900 mb-8">Core Concepts</H2>
        <div class="space-y-10">
          {concepts.map((concept, index) => (
            <div class:list={['pb-10', index < concepts.length - 1 && 'border-b border-gray-200']}>
              <H3 class="text-xl font-semibold text-gray-900 mb-3">{concept.title}</H3>
              <P class="text-gray-600 text-base leading-relaxed mb-5">{concept.description}</P>
              {concept.details && concept.details.length > 0 && (
                <Ul class="space-y-2 text-gray-600 [&]:list-disc [&]:pl-6 text-base leading-relaxed">
                  {concept.details.map(detail => (
                    <Li class="leading-relaxed">{detail}</Li>
                  ))}
                </Ul>
              )}
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Potential Applications Card -->
  {
    potentialApplications && potentialApplications.length > 0 && (
      <section class="bg-white rounded-lg shadow-md p-8">
        <H2 class="text-2xl font-semibold text-gray-900 mb-4">Potential Applications</H2>
        <Ul class="space-y-2">
          {potentialApplications.map(application => (
            <Li class="flex items-start text-gray-700">
              <svg
                class="w-5 h-5 text-gray-400 mr-2 mt-0.5 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
              <P class="text-gray-700">{application}</P>
            </Li>
          ))}
        </Ul>
      </section>
    )
  }

  <!-- Notes/Disclosure Card -->
  {
    notes && (
      <div class="bg-stone-50 border-l-4 border-stone-400 rounded-lg shadow-md p-6">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-stone-400" viewBox="0 0 20 20" fill="currentColor">
              <path
                fill-rule="evenodd"
                d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
                clip-rule="evenodd"
              />
            </svg>
          </div>
          <div class="ml-3">
            <P class="text-sm text-stone-700">{notes}</P>
          </div>
        </div>
      </div>
    )
  }
</article>
