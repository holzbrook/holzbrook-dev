---
import { H1, H2, P, Ul, Li } from '@/lib/ui';
import { LandingPage } from '@/lib/ui';
import type { CollectionEntry } from 'astro:content';

type JobEntry = CollectionEntry<'jobs'>['data'];

interface Props {
  job: JobEntry;
}

const { job } = Astro.props;
const { Content } = await job.render();
---

<div class="space-y-8">
  <LandingPage.Section class="bg-white rounded-lg shadow p-8">
    <div class="space-y-6">
      <header class="space-y-2">
        <H1 class="text-3xl font-bold text-gray-900">{job.data.company}</H1>
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
          <H2 class="text-xl font-semibold text-gray-700">{job.data.title}</H2>
          <P class="text-gray-500">{job.data.period}</P>
        </div>
      </header>

      <div class="prose prose-orange max-w-none">
        <Content />
      </div>

      {
        job.data.highlights && job.data.highlights.length > 0 && (
          <div class="mt-8">
            <H2 class="text-xl font-semibold text-gray-900 mb-4">Key Achievements</H2>
            <Ul class="space-y-3 [&]:list-disc pl-5">
              {job.data.highlights.map((highlight: string) => (
                <Li class="text-gray-700">{highlight}</Li>
              ))}
            </Ul>
          </div>
        )
      }
    </div>
  </LandingPage.Section>
</div>
