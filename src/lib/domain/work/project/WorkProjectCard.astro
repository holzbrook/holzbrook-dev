---
import { H3, P, SecondaryButton } from '@/lib/ui';
import type { WorkProject } from './WorkProject';

interface Props {
  project: WorkProject;
  class?: string;
}

const { project, class: className } = Astro.props;
const { name, description, tech, companyId, status, images } = project;
---

<div
  class:list={[
    'bg-white rounded-lg shadow-md p-8 flex flex-col transition-all duration-300 hover:shadow-lg',
    className,
  ]}
  style="min-height: 280px;"
>
  {/* Header: Title and Company */}
  <div class="flex items-start justify-between gap-4 mb-4">
    <div class="flex-1">
      <H3 class="text-xl font-semibold text-gray-900 mb-2">{name}</H3>
      <div class="flex items-center gap-3 flex-wrap">
        <span class="text-sm text-gray-600 font-medium">{companyId}</span>
        {
          status !== 'completed' && (
            <span
              class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium"
              class:list={[
                status === 'ongoing' && 'bg-stone-100 text-stone-700',
                status === 'archived' && 'bg-gray-100 text-gray-800',
              ]}
            >
              {status}
            </span>
          )
        }
      </div>
    </div>
    {
      images[0] && (
        <img
          src={images[0].url}
          alt={images[0].alt}
          class="w-20 h-20 object-cover rounded-lg flex-shrink-0"
        />
      )
    }
  </div>

  {/* Description - flex-1 to push footer down */}
  <P class="text-gray-600 leading-relaxed flex-1 mb-4">{description}</P>

  {/* Footer: Tech tags and CTA - always at bottom */}
  <div class="flex items-center justify-between gap-4 pt-4 border-t border-gray-100 flex-wrap">
    <div class="flex flex-wrap gap-2">
      {
        tech.map(t => (
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 hover:bg-gray-200 transition-colors">
            {t}
          </span>
        ))
      }
    </div>
    <SecondaryButton as="a" href={`/work/projects/${project.id}`}>
      View Details
      <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
        ></path>
      </svg>
    </SecondaryButton>
  </div>
</div>
