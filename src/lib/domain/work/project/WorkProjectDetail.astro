---
import { H1, H2, P, PrimaryButton, SecondaryButton } from '@/lib/ui';

import type { WorkProject } from './WorkProject';

interface Props {
  project: WorkProject;
}

const { project } = Astro.props;
const {
  name,
  description,
  tech,
  companyId,
  status,
  timeline,
  challenges,
  solutions,
  outcomes,
  images,
  demoUrl,
  caseStudyUrl,
} = project;
---

<article class="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-8">
  <!-- Header Section -->
  <header>
    <div class="flex items-center justify-between mb-4">
      <div>
        <H1 class="text-4xl font-bold text-gray-900 mb-2">{name}</H1>
        <div class="flex items-center gap-3">
          <span class="text-lg text-gray-600">{companyId}</span>
          <span
            class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium"
            class:list={[
              status === 'completed' && 'bg-stone-100 text-stone-700',
              status === 'ongoing' && 'bg-stone-100 text-stone-700',
              status === 'archived' && 'bg-gray-100 text-gray-800',
            ]}
          >
            {status}
          </span>
        </div>
      </div>
      <div class="flex gap-4">
        {
          demoUrl && (
            <PrimaryButton as="a" href={demoUrl} target="_blank" rel="noopener noreferrer">
              View Demo
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                />
              </svg>
            </PrimaryButton>
          )
        }
        {
          caseStudyUrl && (
            <SecondaryButton as="a" href={caseStudyUrl}>
              Read Case Study
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </SecondaryButton>
          )
        }
      </div>
    </div>
    <P class="text-xl text-gray-600">{description}</P>
  </header>

  <!-- Timeline Section -->
  <section>
    <H2 class="text-2xl font-semibold text-gray-900 mb-4">Timeline</H2>
    <div class="flex items-center gap-4 text-gray-600">
      <time datetime={timeline.startDate}>{timeline.startDate}</time>
      {
        timeline.endDate && (
          <>
            <span class="text-gray-400">&rarr;</span>
            <time datetime={timeline.endDate}>{timeline.endDate}</time>
          </>
        )
      }
      {timeline.duration && <span class="text-sm text-gray-500">({timeline.duration})</span>}
    </div>
  </section>

  <!-- Image Gallery -->
  {
    images.length > 0 && (
      <section>
        <H2 class="text-2xl font-semibold text-gray-900 mb-4">Gallery</H2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {images.map(image => (
            <figure class="relative group">
              <img
                src={image.url}
                alt={image.alt}
                class="w-full h-64 object-cover rounded-lg shadow-md"
              />
              {image.caption && (
                <figcaption class="absolute bottom-0 left-0 right-0 p-4 bg-black bg-opacity-50 text-white rounded-b-lg opacity-0 group-hover:opacity-100 transition-opacity">
                  {image.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <!-- Challenges & Solutions -->
  <section class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div>
      <H2 class="text-2xl font-semibold text-gray-900 mb-4">Challenges</H2>
      <ul class="space-y-3">
        {
          challenges.map(challenge => (
            <li class="flex items-start">
              <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-stone-200 text-stone-700 mr-3">
                !
              </span>
              <span class="text-gray-600">{challenge}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <H2 class="text-2xl font-semibold text-gray-900 mb-4">Solutions</H2>
      <ul class="space-y-3">
        {
          solutions.map(solution => (
            <li class="flex items-start">
              <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-stone-200 text-stone-700 mr-3">
                &check;
              </span>
              <span class="text-gray-600">{solution}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Outcomes -->
  <section>
    <H2 class="text-2xl font-semibold text-gray-900 mb-4">Outcomes</H2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        outcomes.map(outcome => (
          <div class="bg-white rounded-lg shadow-md p-8">
            <div class="text-2xl font-bold text-gray-700 mb-2">{outcome.value}</div>
            <div class="text-sm font-medium text-gray-900 mb-1">{outcome.metric}</div>
            {outcome.description && <div class="text-sm text-gray-600">{outcome.description}</div>}
          </div>
        ))
      }
    </div>
  </section>

  <!-- Tech Stack -->
  <section>
    <H2 class="text-2xl font-semibold text-gray-900 mb-4">Tech Stack</H2>
    <div class="flex flex-wrap gap-2">
      {
        tech.map(t => (
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
            {t}
          </span>
        ))
      }
    </div>
  </section>
</article>
