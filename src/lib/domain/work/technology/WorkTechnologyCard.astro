---
import { H3 } from '@/lib/ui';

interface Props {
  title: string;
  items: string[];
  class?: string;
}

const { title, items, class: className } = Astro.props;
---

<div class:list={['bg-white rounded-lg shadow-md p-8 space-y-4', className]}>
  <H3 class="text-lg font-semibold text-gray-900">{title}</H3>
  <div class="flex flex-wrap gap-2">
    {
      items.map(item => (
        <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm hover:bg-gray-200 transition-colors duration-200">
          {item}
        </span>
      ))
    }
  </div>
</div>
